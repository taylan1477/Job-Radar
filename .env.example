# Gemini / Google AI Studio API Anahtarı (Ön Yazı ve E-posta Sınıflandırma için)
GEMINI_API_KEY=

# Gmail SMTP & IMAP Entegrasyonu (Başvuru Gönderme ve Yanıtları Okuma)
# Gmail hesabınızda 2-Adımlı Doğrulama açıkken "Uygulama Şifreleri" (App Passwords) kısmından
# 16 haneli bir şifre alarak buraya yapıştırın.
GMAIL_USER=taylan147701@gmail.com
GMAIL_APP_PASSWORD=

# Başvuru Güvenlik ve Skor Ayarları
MIN_APPLICATION_SCORE=2.5
MAX_APPLICATION_SCORE=10.0
MAX_APPLICATIONS_PER_RUN=15
